{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "no-unused-vars": "warn",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [".next/**", "dist/**", "node_modules/**"]
}
