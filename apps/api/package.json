    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@pharmacy/shared-types": "workspace:*",
    "@pharmacy/validation": "workspace:*",
    "@prisma/client": "^6.4.0",
    "argon2": "^0.45.2",
    "bullmq": "6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "ioredis": "^5.5.0",
    "minio": "^8.0.7",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.6.7"
