    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.5",
    "@pharmacy/shared-types": "workspace:*",
    "@pharmacy/validation": "workspace:*",
    "@prisma/client": "^6.4.0",
    "argon2": "^0.45.2",
    "bullmq": "6.6.0",
    "class-transformer": "^0.5.1",
