    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jest": "^30.5.2",
    "oxlint": "^1.92.0",
    "prisma": "^6.4.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
