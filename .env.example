# ==============================================================================
# Pharmacy Platform - Environment Configuration Template
# ==============================================================================

# --- Node Environment ---
# Allowed values: development | production
NODE_ENV=development

# --- Backend Application (apps/api) ---
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Frontend Application (apps/web) ---
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- PostgreSQL Database (Docker & apps/api) ---
POSTGRES_USER=pharmacy_user
POSTGRES_PASSWORD=pharmacy_secure_pass
POSTGRES_DB=pharmacy_db
POSTGRES_PORT=5432
# Consumed by apps/api (Prisma)
DATABASE_URL=postgresql://pharmacy_user:pharmacy_secure_pass@localhost:5432/pharmacy_db?schema=public

# --- Redis (Docker & apps/api) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pharmacy_redis_pass
REDIS_URL=redis://:pharmacy_redis_pass@localhost:6379

# --- MinIO Object Storage (Docker & apps/api) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_secret_key
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_PRESCRIPTIONS=prescriptions
# Storage Server-Side Encryption (SSE-S3: 'AES256', SSE-KMS: 'aws:kms', empty/none: disabled)
MINIO_SERVER_SIDE_ENCRYPTION=AES256
MINIO_KMS_KEY_ID=
MINIO_KMS_SECRET_KEY=default-key:699No7L9kpVFZHuLfGbz3TyO4fCEm1+9qTP9t34JdLo=

# --- Brevo Transactional Email Configuration (Nodemailer) ---
MAIL_PROVIDER=brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@kolkatapharmacy.com
MAIL_FROM_NAME="Kolkata Pharmacy"

# --- Demo Accounts & Demo OTP ---
DEMO_OTP_ENABLED=true
DEMO_OTP_CODE=123456
DEMO_OTP_EMAILS=customer@example.com,customer2@example.com

# --- Authentication & JWT ---
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_key_at_least_32_bytes
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_key_at_least_32_bytes
JWT_ISSUER=pharmacy-platform
JWT_AUDIENCE=pharmacy-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Redis session/refresh-token TTL in seconds (7 days). Keep aligned with REFRESH_TOKEN_TTL.
REFRESH_TOKEN_TTL_SECONDS=604800
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# --- Prescription AI Reading ---
# Supported providers: mock | gemini
PRESCRIPTION_AI_PROVIDER=mock
# Gemini credentials (required when PRESCRIPTION_AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Timeout & bounded retry policy
PRESCRIPTION_AI_TIMEOUT_MS=60000
PRESCRIPTION_AI_MAX_RETRIES=2

