{
  "name": "pharmacy-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @pharmacy/web dev",
    "dev:api": "pnpm --filter @pharmacy/api start:dev",
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @pharmacy/api build && pnpm --filter @pharmacy/web build",
    "lint": "pnpm --filter @pharmacy/api lint && pnpm --filter @pharmacy/web lint",
    "lint:fix": "pnpm --filter @pharmacy/api lint:fix && pnpm --filter @pharmacy/web lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @pharmacy/api test:unit && pnpm --filter @pharmacy/web test:unit && pnpm --filter @pharmacy/api test:integration",
    "test:unit": "pnpm --filter @pharmacy/api test:unit && pnpm --filter @pharmacy/web test:unit",
    "test:integration": "pnpm --filter @pharmacy/api test:integration",
    "test:e2e": "pnpm --filter @pharmacy/api test:e2e",
    "test:coverage": "pnpm --filter @pharmacy/api test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3"
  }
}
